{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "outDir": "dist/webview",
    "lib": [
      "es2022",
      "dom"
    ],
    "jsx": "react",
    "types": [],
    "sourceMap": true,
    "rootDir": "..",
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true
  },
  "include": [
    "./index.tsx",
    "./basic-editor.tsx",
    "../notion-document.ts",
    "../webview-messages.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
